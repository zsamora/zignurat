# General
LOG_LEVEL=debug
DEV_STAGE=development
# Identirat (IAM service)
IDENTIRAT_APP=identirat-app
IDENTIRAT_PORT=9000
IDENTIRAT_DB=identirat-db
IDENTIRAT_DB_PORT=5432
IDENTIRAT_DB_NAME=identirat
IDENTIRAT_DB_USER=postgres
IDENTIRAT_DB_PW=changeme
# Notariat (registry & certificates)
NOTARIAT_APP=notariat-app
NOTARIAT_PORT=9002
NOTARIAT_DB=notariat-db
NOTARIAT_DB_PORT=5432
NOTARIAT_DB_NAME=notariat
NOTARIAT_DB_USER=postgres
NOTARIAT_DB_PW=changeme
# Identirat login endpoint, as seen by other services on the compose network
IDENTIRAT_URL=identirat-app
IDENTIRAT_LOGIN=loginJSON
# Notariat, as seen by other services on the compose network
NOTARIAT_URL=notariat-app
# JWT and Session cookie signing secrets
JWT_SECRET=changeme
SESSION_SECRET=changeme
